[settings]
chunk_processor_type = "Checkerboard"
analytics_type = "Histogram"
filter_chain = ["Ema", "Gamma"]
hardware_output_type = "ShinombraSerial"

[screen_reading_config]
deep_in = 20
deep_out = 0

[led_position_config]
gap = 5
led_length = 62
horizontal_offset = 20
horizontal_led_amount = 9
vertical_offset = 15
vertical_led_amount = 5

[screen_config]
frame_width_mm = 590
frame_height_mm = 330

[checkerboard_config]
pixel_step = 10
row_stride = 5

[serial_driver_config]
port_path = "/dev/ttyUSB0"
baud_rate = 115200
