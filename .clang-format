# .clang-format
---
# Базовый стиль для C++
BasedOnStyle: LLVM 

# 1. Ширина отступа для всего кода (тело функций, циклы)
IndentWidth: 4

# 2. Стиль скобок (K&R/Attach)
BreakBeforeBraces: Attach 

# 3. Настройка модификаторов доступа (Возвращаем их на уровень класса)
# Смещение -4 возвращает 'public:' на уровень 0, а члены класса остаются на уровне 4.
AccessModifierOffset: -4