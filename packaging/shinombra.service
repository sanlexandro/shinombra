[Unit]
Description=Shinombra ambient lighting daemon by sanlexandro
After=pipewire.service wireplumber.service xdg-desktop-portal.service
Wants=pipewire.service wireplumber.service

After=dbus.service
Requisite=graphical-session.target
PartOf=graphical-session.target
After=graphical-session.target

[Service]
EnvironmentFile=-%h/.config/shinombra/service.env
ExecStart=/usr/bin/shinombra $SHINOMBRA_ARGS
Restart=on-failure
RestartSec=5

ExecStartPre=/usr/bin/gdbus wait --session org.freedesktop.portal.Desktop 10

[Install]
WantedBy=graphical-session.target